<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SurvivalcraftGenius</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Single source of truth for the mod version; keep modinfo.json in sync. -->
    <Version>0.8.5</Version>
    <AssemblyVersion>0.8.5.0</AssemblyVersion>
    <FileVersion>0.8.5.0</FileVersion>
    <InformationalVersion>0.8.5</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Survivalcraft">
      <HintPath>$(SurvivalcraftDir)Survivalcraft.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Engine">
      <HintPath>$(SurvivalcraftDir)Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EntitySystem">
      <HintPath>$(SurvivalcraftDir)EntitySystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SurvivalcraftDir)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
